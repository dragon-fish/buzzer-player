// ============================================
// 《小星星 - 超维闪耀交响版》
// 12 轨全火力开路，展示 BZS v0.3.0 极限编曲能力
// ============================================

tempo=145
ticks_per_beat=96
master_volume=0.75
time_signature=4/4

// ============================================
// 全局片段定义 (Global Patterns)
// ============================================

@pattern m_a
C4 4 C4 4 G4 4 G4 4 | A4 4 A4 4 G4 2 |
F4 4 F4 4 E4 4 E4 4 | D4 4 D4 4 C4 2 |
@end

@pattern m_b
G4 4 G4 4 F4 4 F4 4 | E4 4 E4 4 D4 2 |
G4 4 G4 4 F4 4 F4 4 | E4 4 E4 4 D4 2 |
@end

// ============================================
// [旋律组] 4音轨叠加 - 打造震撼的主音
// ============================================

@track Lead_Main waveform=pulse duty=50 volume=0.20 pan=-0.3
:env a=2 d=10 s=0.8 r=12
:call m_a :call m_b :call m_a

@track Lead_Bright waveform=pulse duty=12 volume=0.15 pan=0.3
:env a=0 d=5 s=0.7 r=8
:vib depth=0.15 rate=16
:call m_a :call m_b :call m_a

@track Lead_Sub waveform=triangle volume=0.12 pan=0
:env a=5 d=15 s=0.5 r=20
:call m_a :call m_b :call m_a

@track Counter_Melody delay=16 waveform=pulse duty=25 volume=0.12 pan=0.5
:env pluck
:gate 0.4
// 副旋律：在主旋律长音处跳动
:loop 2
  R 4 E5 8 G5 8 R 4 G5 4 | R 4 D5 8 F5 8 R 4 F5 4 |
:endloop

// ============================================
// [和声与琶音组] 3音轨 - 填满空间
// ============================================

@track Arp_Fast waveform=pulse duty=12 volume=0.08 pan=-0.6
:env pluck
:gate 0.3
:arp semi 7 12 rate=4
:loop 8
  C3 2 G3 2 | F3 2 C3 2 | A2 2 E3 2 | G2 2 C3 2 |
:endloop
:arp off

@track Pad_Wall waveform=triangle volume=0.10 pan=0.6
:env a=48 d=96 s=0.4 r=64
:loop 4
  [ C3 E3 G3 ] 1 | [ F3 A3 C4 ] 1 | [ G3 B3 D4 ] 1 | [ C3 E3 G3 ] 1 |
:endloop

@track Arp_Chords waveform=pulse duty=75 volume=0.10 pan=0
:env a=0 d=12 s=0 r=0
:gate 0.5
:loop 16
  :arp semi 4 7 12 rate=12
  C3 4 E3 4 G3 4 B2 4
:endloop

// ============================================
// [低音组] 2音轨 - 震撼的根基
// ============================================

@track Bass_Heavy waveform=pulse duty=50 volume=0.20 pan=0
:env a=2 d=24 s=0.6 r=8
:loop 8
  C2 4 C2 8 C2 8 G1 4 G1 4 | F1 4 F1 8 F1 8 C2 2 |
:endloop

@track Bass_Sub waveform=triangle volume=0.15 pan=0
:loop 8
  C1 2 G0 2 | F0 2 C1 2 |
:endloop

// ============================================
// [节奏组] 3音轨 - 动态冲击
// ============================================

@track Kick waveform=noise volume=0.25
:env a=0 d=4 s=0 r=0
:noise mode=short pitch=5
:loop 32
  C2 4 R 4 C2 8 C2 8 R 4
:endloop

@track Snare waveform=noise volume=0.18
:env a=0 d=8 s=0.2 r=4
:noise mode=long pitch=15
:loop 32
  R 4 C2 4 R 4 C2 4
:endloop

@track HiHat waveform=noise volume=0.12 pan=0.4
:env a=0 d=2 s=0 r=0
:noise mode=short pitch=31
:loop 64
  C2 8 :gate 0.2 C2 16 C2 16 :gate 1.0
:endloop

// ============================================
// [特效组] 氛围渲染
// ============================================

@track Riser delay=28 waveform=noise volume=0.15
:env a=96 d=0 s=1.0 r=0
:noise mode=long pitch=1
:slide speed=0.01
C2 1  // 持续升高的白噪声冲向高潮
:slide off

@track Starlight waveform=pulse duty=12 volume=0.08
:env a=0 d=2 s=0 r=0
:loop 128
  :gate 0.1
  C6 16 R 16 E7 32 R 32 G6 16 R 16
:endloop

// 终曲大爆发
[ C2 C3 E4 G4 C5 E5 G5 C6 ] 1