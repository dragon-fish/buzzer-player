{
  "name": "buzzer-player",
  "version": "0.3.0",
  "description": "A library for playing buzzer scripts with BZS (Buzzer Script) language support",
  "type": "module",
  "main": "./dist/buzzer-player.cjs",
  "module": "./dist/buzzer-player.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    "package.json": "./package.json",
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/buzzer-player.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/buzzer-player.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.web.ts",
    "build": "vite build",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "vite preview --config vite.config.web.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "buzzer",
    "music",
    "audio",
    "synthesizer",
    "web-audio",
    "chiptune"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/buzzer-player.git"
  },
  "dependencies": {
    "langium": "^4.1.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.55.2",
    "@types/node": "^24.10.8",
    "jsx-dom": "^8.1.6",
    "typescript": "^5.7.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^7.3.1"
  }
}