{
  "name": "buzzer-player",
  "version": "0.3.0",
  "description": "A library for playing buzzer scripts with BZS (Buzzer Script) language support",
  "type": "module",
  "main": "./dist/buzzer-player.cjs",
  "module": "./dist/buzzer-player.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/buzzer-player.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/buzzer-player.cjs"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite --config vite.config.web.ts",
    "build": "npm run build:lib && npm run build:types",
    "build:lib": "vite build",
    "build:types": "tsc --project tsconfig.lib.json",
    "build:web": "vite build --config vite.config.web.ts",
    "preview": "vite preview --config vite.config.web.ts",
    "prepublishOnly": "npm run build",
    "lsp:bzs": "node tools/bzs-lsp-server.mjs"
  },
  "keywords": [
    "buzzer",
    "music",
    "audio",
    "synthesizer",
    "web-audio",
    "chiptune"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/buzzer-player.git"
  },
  "dependencies": {
    "langium": "^4.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "jsx-dom": "^8.1.6",
    "typescript": "~5.7.2",
    "vite": "^6.3.1",
    "vscode-languageserver": "^9.0.1"
  }
}
